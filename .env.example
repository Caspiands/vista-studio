# Copy to .env.local and change every value before sharing the site with a client.

# Editor account: can toggle edit mode, change any element, publish, and reset content.
CMS_EDITOR_USERNAME=admin
CMS_EDITOR_PASSWORD=vista-admin-2027

# Viewer account: read-only access to the published showcase.
CMS_VIEWER_USERNAME=client
CMS_VIEWER_PASSWORD=vista-client-2027

# Secret used to sign session cookies. Use a long random string.
CMS_SESSION_SECRET=change-me-in-production-vista-dtr

# Where published content is stored (defaults to ./data). Point at a persistent volume in production.
# CMS_DATA_DIR=/var/lib/vista-dtr

# Set to "true" to hide the demo-credentials panel on the login page even when defaults are active.
# CMS_HIDE_DEMO_CREDENTIALS=true
